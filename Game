<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CYBER PONG 2077 - 91種超能融合與三維旋球終極版</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Noto+Sans+TC:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        * { user-select: none; -webkit-user-select: none; touch-action: none; }
        body {
            background-color: #03040a;
            overflow: hidden;
            font-family: 'Noto Sans TC', 'Orbitron', sans-serif;
            color: #fff;
        }
        .cyber-font { font-family: 'Orbitron', monospace; }
        .cyber-panel {
            background: rgba(8, 14, 30, 0.82);
            border: 1px solid rgba(0, 242, 254, 0.4);
            box-shadow: 0 0 18px rgba(0, 242, 254, 0.12);
            backdrop-filter: blur(8px);
        }
        .cyber-btn {
            background: linear-gradient(135deg, rgba(255, 0, 128, 0.14) 0%, rgba(0, 242, 254, 0.14) 100%);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.15s ease;
        }
        .cyber-btn:hover, .cyber-btn.active {
            background: linear-gradient(135deg, rgba(255, 0, 128, 0.55) 0%, rgba(0, 242, 254, 0.55) 100%);
            border-color: #00f2fe;
            box-shadow: 0 0 14px rgba(0, 242, 254, 0.5);
            transform: translateY(-1px);
        }
        .cyber-btn:active { transform: scale(0.95); }
        @keyframes manaPulse {
            0%, 100% { box-shadow: 0 0 8px #00f2fe; }
            50% { box-shadow: 0 0 22px #fde047, inset 0 0 10px #fff; }
        }
        .mana-ready { animation: manaPulse 0.75s infinite ease-in-out; }
    </style>
</head>
<body class="w-screen h-screen flex flex-col relative select-none">

    <div id="game-container" class="w-full h-full relative overflow-hidden flex items-center justify-center bg-[#03050c]">
        <canvas id="gameCanvas" class="block w-full h-full cursor-none"></canvas>

        <!-- 極簡化頂部 HUD -->
        <div id="in-game-hud" class="absolute top-2.5 inset-x-2.5 md:inset-x-6 z-20 flex justify-between items-start pointer-events-none hidden">
            
            <!-- 左側：玩家能量與狀態 -->
            <div class="cyber-panel px-3 py-2 rounded-xl flex flex-col gap-1.5 min-w-[175px] sm:min-w-[235px]">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5">
                        <span id="hud-skill-name" class="font-black text-xs text-cyan-300 truncate max-w-[115px] sm:max-w-[140px]">🔥 熾焰重扣</span>
                        <span id="hud-skill-lv" class="text-[10px] px-1.5 py-0.2 bg-amber-500/20 border border-amber-400/50 rounded text-amber-300 font-bold">LV.1</span>
                    </div>
                    <span id="hud-mana" class="cyber-font text-xs font-black text-cyan-300">100%</span>
                </div>
                <div class="w-full bg-slate-900 h-2 rounded-full overflow-hidden border border-cyan-500/40 p-[1px]">
                    <div id="hud-mana-bar" class="h-full bg-gradient-to-r from-cyan-400 via-blue-400 to-amber-300 rounded-full transition-all duration-150" style="width:100%"></div>
                </div>
                <div class="flex items-center justify-between text-[10px] text-slate-300">
                    <span id="ai-brain-status" class="truncate max-w-[130px] sm:max-w-[165px]">🧠 AI：分析球路中...</span>
                    <button onclick="evolvePlayerSkill()" id="btn-evolve" class="pointer-events-auto px-1.5 py-0.5 rounded bg-amber-500/30 hover:bg-amber-500/50 border border-amber-400 text-amber-200 font-black animate-pulse">
                        ⬆️E進化
                    </button>
                </div>
            </div>

            <!-- 中央：極簡比分板 -->
            <div class="cyber-panel px-4 sm:px-7 py-1.5 rounded-2xl flex flex-col items-center">
                <div class="flex items-center gap-1.5 text-[9px] sm:text-[10px] text-cyan-300/80 tracking-widest uppercase font-bold">
                    <span id="hud-diff-tag">NORMAL</span>
                    <span>·</span>
                    <span id="chain-badge" class="text-amber-300">CHAIN x0</span>
                    <span id="resonance-badge" class="hidden px-1.5 rounded bg-fuchsia-600/50 text-fuchsia-200 animate-pulse">⚡共鳴</span>
                </div>
                <div class="flex items-center gap-3 sm:gap-4 text-2xl sm:text-4xl font-black cyber-font leading-tight">
                    <span id="score-player" class="text-cyan-400">0</span>
                    <span class="text-slate-600 text-lg">:</span>
                    <span id="score-ai" class="text-pink-500">0</span>
                </div>
                <div id="spin-indicator" class="text-[10px] font-bold text-cyan-200">⚡ 快攻平擊 DRIVE</div>
            </div>

            <!-- 右側：精簡控制圖示列 -->
            <div class="flex items-center gap-1.5 pointer-events-auto">
                <button onclick="toggleSound()" id="btn-sound" class="cyber-panel hover:border-white w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center text-xs sm:text-sm" title="音效">🔊</button>
                <button onclick="togglePause()" class="cyber-panel hover:border-white w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center text-xs sm:text-sm" title="暫停">⏸️</button>
                <button onclick="restartMatch()" class="cyber-panel hover:border-white w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center text-xs sm:text-sm" title="重開">🔄</button>
                <button onclick="exitToMenu()" class="cyber-panel hover:bg-rose-600/40 px-2.5 h-8 sm:h-9 rounded-xl flex items-center text-xs font-bold text-rose-300 border border-rose-500/50">
                    🚪 退出
                </button>
            </div>
        </div>

        <!-- 左側玩家切入播報 (不擋球台) -->
        <div id="left-toast" class="fixed left-3 top-[32%] z-20 pointer-events-none transition-all duration-200 opacity-0 -translate-x-8">
            <div class="bg-gradient-to-r from-slate-950/90 to-transparent border-l-4 border-cyan-400 pl-3 pr-6 py-1.5 rounded-r-xl backdrop-blur-sm">
                <div id="left-toast-title" class="text-base sm:text-xl font-black cyber-font text-cyan-300"></div>
                <div id="left-toast-sub" class="text-[10px] font-bold text-white/90 uppercase"></div>
            </div>
        </div>

        <!-- 右側 AI 切入播報 (不擋球台) -->
        <div id="right-toast" class="fixed right-3 top-[32%] z-20 pointer-events-none transition-all duration-200 opacity-0 translate-x-8 text-right">
            <div class="bg-gradient-to-l from-slate-950/90 to-transparent border-r-4 border-pink-500 pr-3 pl-6 py-1.5 rounded-l-xl backdrop-blur-sm">
                <div id="right-toast-title" class="text-base sm:text-xl font-black cyber-font text-pink-400"></div>
                <div id="right-toast-sub" class="text-[10px] font-bold text-white/90 uppercase"></div>
            </div>
        </div>

        <!-- 頂部高空融合/得分通知 -->
        <div id="top-toast" class="fixed top-[13%] inset-x-0 z-20 pointer-events-none flex justify-center transition-all duration-200 opacity-0 scale-90 px-3">
            <div class="bg-slate-950/95 border border-amber-400/80 px-5 py-1 rounded-full shadow-[0_0_30px_rgba(251,191,36,0.55)] text-center">
                <span id="top-toast-title" class="text-sm sm:text-lg font-black cyber-font text-amber-300 mr-2"></span>
                <span id="top-toast-sub" class="text-[11px] font-bold text-white"></span>
            </div>
        </div>

        <!-- 底部街機雙拇指按鍵 + 電腦簡明操作條 -->
        <div id="bottom-bar" class="absolute bottom-3 inset-x-3 md:inset-x-8 flex justify-between items-end z-20 pointer-events-none hidden">
            <!-- 左下：高空球按鈕 (支援手機拇指與滑鼠右鍵) -->
            <button onclick="triggerLobShot()" class="pointer-events-auto w-16 h-16 sm:w-20 sm:h-14 rounded-2xl cyber-panel active:scale-90 flex flex-col items-center justify-center border border-indigo-400/60 shadow-lg">
                <span class="text-base sm:text-lg">🎈 高球</span>
                <span class="text-[9px] text-indigo-300 font-bold">滑鼠右鍵</span>
            </button>

            <!-- 中央：簡明操作提示 (手機上自動隱藏避免擁擠) -->
            <div class="hidden md:flex flex-col items-center gap-1 bg-black/65 px-4 py-1.5 rounded-full border border-white/15 text-[11px] text-slate-300">
                <div>🏓 <b>左鍵</b>：揮拍 (上甩弧圈/下甩削球/橫甩側旋) ｜ <b>右鍵</b>：挑高空球 ｜ <b>空白鍵</b>：釋放超能力 ｜ <b>E鍵</b>：進化技能</div>
            </div>

            <!-- 右下：超能力必殺按鈕 (支援手機拇指與空白鍵) -->
            <button onclick="castSkill()" id="btn-mobile-skill" class="pointer-events-auto w-20 h-16 sm:w-28 sm:h-14 rounded-2xl cyber-panel active:scale-90 flex flex-col items-center justify-center border border-cyan-400 shadow-lg transition">
                <span id="btn-skill-label" class="text-sm sm:text-base font-black text-cyan-300">⚡ 技能</span>
                <span class="text-[9px] text-slate-300 font-bold">空白鍵 SPACE</span>
            </button>
        </div>

        <!-- 暫停彈窗 -->
        <div id="pause-modal" class="hidden absolute inset-0 bg-black/75 backdrop-blur-md flex items-center justify-center p-4 z-40 pointer-events-auto">
            <div class="cyber-panel max-w-xs w-full rounded-2xl p-6 text-center space-y-3">
                <h3 class="text-2xl font-black cyber-font text-cyan-400">PAUSED</h3>
                <button onclick="togglePause()" class="w-full py-3 cyber-btn active rounded-xl font-bold text-sm">繼續比賽 (RESUME)</button>
                <button onclick="restartMatch()" class="w-full py-3 cyber-btn rounded-xl font-bold text-sm">重新開始 (RESTART)</button>
                <button onclick="exitToMenu()" class="w-full py-3 bg-rose-500/20 border border-rose-500/50 text-rose-300 rounded-xl font-bold text-sm">退出選單 (EXIT)</button>
            </div>
        </div>

        <!-- 戰前準備選單 (13大技能 + 3大難度，清爽緊湊排版) -->
        <div id="setup-modal" class="absolute inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center p-2 sm:p-4 z-40 overflow-y-auto">
            <div class="cyber-panel max-w-4xl w-full rounded-2xl p-4 sm:p-6 flex flex-col shadow-[0_0_50px_rgba(0,242,254,0.2)] pointer-events-auto my-auto">
                <div class="text-center mb-3">
                    <h1 class="text-2xl sm:text-4xl font-black cyber-font text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-pink-500">
                        CYBER PONG 2077
                    </h1>
                    <p class="text-slate-400 text-xs mt-0.5">左鍵揮拍旋球 · 右鍵放高空球 · 空白鍵釋放超能力（80%能量可反制融合 91 種神技）</p>
                </div>

                <!-- 1. 難度選擇 -->
                <div class="mb-3">
                    <div class="text-[11px] font-bold text-cyan-400 mb-1.5 uppercase tracking-wider">1. 選擇 AI 難度 (DIFFICULTY)</div>
                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="selectDiff('easy')" id="diff-easy" class="cyber-btn py-2 px-3 rounded-xl text-center">
                            <div class="font-bold text-xs sm:text-sm">休閒 EASY</div>
                            <div class="text-[10px] text-slate-400 hidden sm:block">慢速好接</div>
                        </button>
                        <button onclick="selectDiff('normal')" id="diff-normal" class="cyber-btn active py-2 px-3 rounded-xl text-center">
                            <div class="font-bold text-xs sm:text-sm text-cyan-300">標準 NORMAL</div>
                            <div class="text-[10px] text-slate-300 hidden sm:block">10技能輪換</div>
                        </button>
                        <button onclick="selectDiff('hard')" id="diff-hard" class="cyber-btn py-2 px-3 rounded-xl text-center">
                            <div class="font-bold text-xs sm:text-sm text-pink-400">宗師 INSANE 🔥</div>
                            <div class="text-[10px] text-slate-300 hidden sm:block">學習預判+融合反制</div>
                        </button>
                    </div>
                </div>

                <!-- 2. 13大基礎技能選擇 -->
                <div class="mb-4">
                    <div class="text-[11px] font-bold text-pink-400 mb-1.5 uppercase tracking-wider">2. 選擇專屬超能力 (13 選 1 · 支援 91 種雙重融合與三階旋球神技)</div>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-1.5 sm:gap-2" id="skill-grid-container"></div>
                </div>

                <button onclick="initMatch()" class="w-full py-3.5 bg-gradient-to-r from-cyan-500 via-blue-500 to-pink-500 hover:brightness-110 active:scale-98 text-white font-black text-sm sm:text-base cyber-font rounded-xl shadow-[0_0_25px_rgba(0,242,254,0.5)] transition">
                    START FULLSCREEN MATCH (全螢幕開始對決)
                </button>
            </div>
        </div>

        <!-- 結算彈窗 -->
        <div id="gameover-modal" class="hidden absolute inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-50 pointer-events-auto">
            <div class="cyber-panel max-w-sm w-full rounded-2xl p-6 text-center">
                <h2 id="go-title" class="text-4xl font-black cyber-font mb-1"></h2>
                <p id="go-sub" class="text-xs text-slate-300 mb-4"></p>
                <div class="text-3xl font-black cyber-font text-white mb-5 bg-slate-950/80 py-2.5 rounded-xl border border-slate-800">
                    <span id="go-p1" class="text-cyan-400">0</span> <span class="text-slate-600 mx-2">-</span> <span id="go-ai" class="text-pink-500">0</span>
                </div>
                <div class="flex flex-col gap-2">
                    <button onclick="restartMatch()" class="w-full py-3 bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 font-black text-sm cyber-font rounded-xl">PLAY AGAIN (再戰一局)</button>
                    <button onclick="exitToMenu()" class="w-full py-2.5 cyber-btn text-white font-bold text-xs rounded-xl">更換技能 / 難度 (MENU)</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ================= 一、13 大基礎技能與 91 種完整融合矩陣定義 =================
        const ARCH_STYLE = {
            fire:    { color: '#f97316', glow: '#fde047', textCls: 'text-amber-400' },
            thunder: { color: '#fef08a', glow: '#38bdf8', textCls: 'text-yellow-300' },
            gravity: { color: '#818cf8', glow: '#c084fc', textCls: 'text-indigo-300' },
            sonic:   { color: '#34d399', glow: '#a7f3d0', textCls: 'text-emerald-300' },
            ghost:   { color: '#e879f9', glow: '#38bdf8', textCls: 'text-purple-400' },
            prism:   { color: '#22d3ee', glow: '#ffffff', textCls: 'text-cyan-300' },
            chrono:  { color: '#38bdf8', glow: '#bae6fd', textCls: 'text-sky-300' },
            leech:   { color: '#fb7185', glow: '#fda4af', textCls: 'text-rose-400' },
            mirror:  { color: '#e2e8f0', glow: '#38bdf8', textCls: 'text-slate-200' },
            laser:   { color: '#00f2fe', glow: '#f43f5e', textCls: 'text-cyan-200' },
            void:    { color: '#a855f7', glow: '#1e1b4b', textCls: 'text-purple-300' },
            frost:   { color: '#7dd3fc', glow: '#ffffff', textCls: 'text-sky-200' },
            toxin:   { color: '#a3e635', glow: '#4d7c0f', textCls: 'text-lime-400' }
        };

        const BASE_SKILLS = [
            { id: 'fire',    name: '🔥 熾焰重扣', desc: '極速火球·留烈焰加速帶', arch: 'fire' },
            { id: 'thunder', name: '⚡ 雷霆瞬影', desc: 'Z字瞬移·留EMP麻痺網', arch: 'thunder' },
            { id: 'gravity', name: '🪐 黑洞重力', desc: '引力拉扯·貼地零彈跳', arch: 'gravity' },
            { id: 'sonic',   name: '💨 音速疾風', desc: '大外旋音爆·落地二次飆速', arch: 'sonic' },
            { id: 'ghost',   name: '🌀 次元幽靈', desc: '3分身螺旋交錯混淆AI', arch: 'ghost' },
            { id: 'prism',   name: '🛡️ 稜鏡力場', desc: '張開全息盾牆自動反彈1次', arch: 'prism' },
            { id: 'chrono',  name: '⏳ 時滯領域', desc: '全場降速40%·甜區放大', arch: 'chrono' },
            { id: 'leech',   name: '🩸 熵能汲取', desc: '抽取對手30%能量轉為己用', arch: 'leech' },
            { id: 'mirror',  name: '🪞 鏡像複製', desc: '複製敵方技能湊同系超載', arch: 'mirror' },
            { id: 'laser',   name: '💎 相位雷射', desc: '直線穿透幻影·貼地滑行', arch: 'laser' },
            { id: 'void',    name: '🌑 虛空相位', desc: '週期性隱身閃爍·干擾預判', arch: 'void' },
            { id: 'frost',   name: '❄️ 絕對冰霜', desc: '生成大範圍冰面減速55%', arch: 'frost' },
            { id: 'toxin',   name: '☠️ 劇毒腐蝕', desc: '生成毒池疊加中毒麻痺1秒', arch: 'toxin' }
        ];

        const SKILL_META = {};
        BASE_SKILLS.forEach(s => {
            SKILL_META[s.id] = { ...s, ...ARCH_STYLE[s.arch], isFusion: false };
        });

        // 完整 91 種融合定義 (13 同系超載 + 78 異系融合)
        const RAW_FUSIONS = [
            // 2.1 同系超載 (13)
            ['fire+fire',       'inferno_overload', '☄️ 滅世隕星·超載', 'fire'],
            ['thunder+thunder', 'storm_emperor',    '🌩️ 雷帝領域·超載', 'thunder'],
            ['gravity+gravity', 'black_hole',       '🕳️ 真·奇點坍縮',   'gravity'],
            ['sonic+sonic',     'mach_breaker',     '🌀 音障突破·超載', 'sonic'],
            ['ghost+ghost',     'phantom_army',     '👻 萬象幻影軍團',  'ghost'],
            ['prism+prism',     'mirror_maze',      '🪞 鏡面迷宮',      'prism'],
            ['chrono+chrono',   'time_stop',        '⏳ 絕對時空靜止',  'chrono'],
            ['leech+leech',     'energy_siphon',    '🩸 能量虹吸',      'leech'],
            ['mirror+mirror',   'infinite_mirror',  '🪞 無限鏡像',      'mirror'],
            ['laser+laser',     'prism_matrix',     '🔷 光稜矩陣',      'laser'],
            ['void+void',       'void_devour',      '🕳️ 虛空吞噬',      'void'],
            ['frost+frost',     'absolute_zero',    '🧊 絕對零度',      'frost'],
            ['toxin+toxin',     'plague',           '☣️ 瘟疫爆發',      'toxin'],
            // 2.2 fire 系列 (12)
            ['fire+thunder', 'plasma',         '💥 雷炎裁決',     'thunder'],
            ['fire+gravity', 'magma_core',     '🌋 熔岩核心',     'gravity'],
            ['fire+sonic',   'flare_dash',     '🔥 烈焰音爆閃',   'sonic'],
            ['fire+ghost',   'will_o_wisp',    '🔥 幽冥鬼火陣',   'ghost'],
            ['fire+prism',   'prism_cannon',   '💎 稜鏡激光加農', 'fire'],
            ['fire+chrono',  'thermal_stasis', '🔥 熱滯爆燃',     'chrono'],
            ['fire+leech',   'flame_drain',    '🔥 烈焰汲取',     'leech'],
            ['fire+mirror',  'mirror_flame',   '🪞 鏡火雙生',     'fire'],
            ['fire+laser',   'solar_beam',     '🔆 恆星射線',     'laser'],
            ['fire+void',    'dark_flame',     '🖤 暗焰吞噬',     'void'],
            ['fire+frost',   'thermal_shock',  '❄️🔥 冰火湮滅',   'frost'],
            ['fire+toxin',   'plague_flame',   '☣️🔥 疫火',       'toxin'],
            // thunder 系列 (11)
            ['thunder+gravity', 'gravity_storm', '🌩️ 引力雷暴',   'thunder'],
            ['thunder+sonic',   'railgun',       '⚡ 超電磁砲',   'thunder'],
            ['thunder+ghost',   'phantom_bolt',  '⚡ 幻影雷襲',   'ghost'],
            ['thunder+prism',   'tesla_wall',    '🛡️ 特斯拉壁壘', 'prism'],
            ['thunder+chrono',  'time_thunder',  '⏳ 時空雷帝',   'chrono'],
            ['thunder+leech',   'volt_drain',    '🩸 電壓汲取',   'leech'],
            ['thunder+mirror',  'mirror_bolt',   '🪞 鏡雷反射',   'thunder'],
            ['thunder+laser',   'railgun_laser', '⚡ 超電磁砲',   'laser'],
            ['thunder+void',    'void_thunder',  '🌩️ 虛空雷帝',   'void'],
            ['thunder+frost',   'cryo_storm',    '🌨️ 極寒風暴',   'frost'],
            ['thunder+toxin',   'venom_bolt',    '☣️⚡ 毒雷',     'toxin'],
