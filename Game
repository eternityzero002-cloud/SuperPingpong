        // ================= 特效與 3D 繪圖引擎 =================
        function spawnParticles(x, y, z, color, count, speedScale = 5) {
            for (let i = 0; i < count; i++) {
                const ang = Math.random() * Math.PI * 2;
                const spd = (0.4 + Math.random() * 0.8) * speedScale;
                particles.push({
                    x, y, z,
                    vx: Math.cos(ang) * spd, vy: Math.random() * spd + 2, vz: (Math.random() - 0.5) * spd,
                    c: color, s: 2.5 + Math.random() * 3.8, a: 1.0, life: 0.36 + Math.random() * 0.24
                });
            }
        }

        function createLightningChain(x1, y1, z1, x2, y2, z2, color = '#fef08a') {
            const pts = [];
            for (let i = 0; i <= 6; i++) {
                const t = i / 6;
                const jit = (i === 0 || i === 6) ? 0 : (Math.random() - 0.5) * 38;
                pts.push({ x: x1 + (x2 - x1) * t + jit, y: y1 + (y2 - y1) * t + Math.abs(jit * 0.5), z: z1 + (z2 - z1) * t });
            }
            ball.lightningBolts.push({ pts, alpha: 1.0, color });
        }

        function updateEffects(dt) {
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i]; p.x += p.vx; p.y += p.vy; p.z += p.vz; p.a -= dt / p.life;
                if (p.a <= 0) particles.splice(i, 1);
            }
            for (let i = shockwaves.length - 1; i >= 0; i--) {
                const sw = shockwaves[i]; sw.r += (sw.maxR - sw.r) * 0.22; sw.alpha -= dt * 2.2;
                if (sw.alpha <= 0) shockwaves.splice(i, 1);
            }
            for (let i = lightPillars.length - 1; i >= 0; i--) {
                lightPillars[i].alpha -= dt * 2.5;
                if (lightPillars[i].alpha <= 0) lightPillars.splice(i, 1);
            }
            for (let i = ball.lightningBolts.length - 1; i >= 0; i--) {
                ball.lightningBolts[i].alpha -= dt * 3.8;
                if (ball.lightningBolts[i].alpha <= 0) ball.lightningBolts.splice(i, 1);
            }
            for (let i = lingeringFields.length - 1; i >= 0; i--) {
                lingeringFields[i].timer -= dt;
                if (lingeringFields[i].timer <= 0) lingeringFields.splice(i, 1);
            }
        }

        function drawScene() {
            ctx.save();
            if (shake > 0) ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);

            drawCyberArena();
            drawArenaBarriers();
            drawAiEntity();
            drawTableLegs3D();
            drawTableSurface3D();
            drawNet3D();
            drawPrismShieldWall();
            drawBallShadow3D();
            drawAllEffects();
            drawRibbonBall3D();
            drawPlayerPaddle3D();

            if (screenFlashAlpha > 0) {
                ctx.fillStyle = screenFlashColor;
                ctx.globalAlpha = screenFlashAlpha;
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.globalAlpha = 1.0;
            }
            ctx.restore();
        }

        function drawCyberArena() {
            const hy = canvas.height * CAM.horiz;
            const skyGrad = ctx.createLinearGradient(0, 0, 0, hy + 80);
            skyGrad.addColorStop(0, '#020308');
            skyGrad.addColorStop(1, resonanceActive ? '#240a35' : '#0a1029');
            ctx.fillStyle = skyGrad;
            ctx.fillRect(0, 0, canvas.width, hy + 80);

            const floorGrad = ctx.createLinearGradient(0, hy, 0, canvas.height);
            floorGrad.addColorStop(0, resonanceActive ? '#1a0926' : '#080c1e');
            floorGrad.addColorStop(0.5, chronoTimer > 0 ? '#082038' : '#101735');
            floorGrad.addColorStop(1, '#040610');
            ctx.fillStyle = floorGrad;
            ctx.fillRect(0, hy, canvas.width, canvas.height - hy);

            ctx.strokeStyle = resonanceActive ? 'rgba(232, 121, 249, 0.16)' : 'rgba(0, 242, 254, 0.08)';
