        function evolvePlayerSkill() {
            if (!gameRunning || isPaused || skillLevel >= 2 || mana.p < 100) return;
            mana.p = 0;
            skillLevel = 2;
            document.getElementById('hud-skill-lv').innerText = 'LV.2★';
            document.getElementById('btn-evolve').classList.add('hidden');
            sfx.fusionClash();
            shake = 18;
            screenFlashColor = '#fde047';
            screenFlashAlpha = 0.4;
            updateHUD();
            showTopToast(`⬆️ SKILL EVOLVED : ${SKILL_META[cfgSkill].name} LV.2`, '威力、地形範圍與破防率永久 ×1.4！');
        }

        // ================= 側面救球與操作手感優化核心 =================
        function updatePlayerPaddle(dt) {
            const pRef = project(0, pPaddle.y, pPaddle.z);
            const scale = pRef.scale || 1;
            const worldX = (mouse.x - canvas.width * 0.5) / scale;
            const worldY = CAM.y - (mouse.y - canvas.height * CAM.horiz) / scale;

            let fieldSlow = 1.0;
            lingeringFields.forEach(f => {
                if (f.z > 0 && Math.hypot(pPaddle.x - f.x, pPaddle.z - f.z) < f.r * 1.35) {
                    if (f.type === 'gravity') pPaddle.x += (f.x - pPaddle.x) * 0.075;
                    if (f.type === 'frost') fieldSlow = 0.45;
                    if (f.type === 'thunder' || f.type === 'fire') fieldSlow = 0.5;
                    if (f.type === 'toxin') {
                        pPaddle.poisonStacks += dt * 1.3;
                        if (pPaddle.poisonStacks >= 3) {
                            pPaddle.poisonStacks = 0;
                            pPaddle.stunTimer = 1.0;
                            showSideToast('right', '☠️ POISON PARALYSIS!', '中毒滿 3 層 · 麻痺 1 秒！', 'text-lime-400');
                        }
                    }
                }
            });

            // 提升反應跟手度 (0.85)，使側面救球毫不拖泥帶水
            const followRate = (pPaddle.stunTimer > 0 ? 0.18 : 0.85) * fieldSlow;
            const nextX = pPaddle.x + (worldX - pPaddle.x) * followRate;
            const nextY = pPaddle.y + (worldY - pPaddle.y) * followRate;

            pPaddle.vx = (nextX - pPaddle.x) / Math.max(0.01, dt * 60);
            pPaddle.vy = (nextY - pPaddle.y) / Math.max(0.01, dt * 60);

            pPaddle.x = Math.max(-T_W * 1.65, Math.min(T_W * 1.65, nextX));
            pPaddle.y = Math.max(10, Math.min(140, nextY));

            if (pPaddle.stunTimer > 0) pPaddle.stunTimer -= dt;
            if (pPaddle.knockbackZ > 0) pPaddle.knockbackZ = Math.max(0, pPaddle.knockbackZ - dt * 110);

            const targetTilt = Math.max(-0.48, Math.min(0.48, (pPaddle.x / T_W) * 0.22 + pPaddle.vx * 0.018));
            pPaddle.tilt += (targetTilt - pPaddle.tilt) * 0.35;

            // 判斷是否進入最佳擊球區 (含側面放寬與螢幕空間感應)
            pPaddle.inStrikeZone = isBallHittableByPlayer();

            // 手機觸控模式下，當手指移動對準球且球進入最佳擊球區時自動揮拍！
            if (isTouchMode && pPaddle.inStrikeZone && pPaddle.swingTimer <= 0 && ball.z >= 330) {
                triggerPlayerSwing();
            }
        }

        // 結合 3D 座標 + 2D 螢幕視覺距離 + 側面橫向拓寬的擊球判定
        function isBallHittableByPlayer(extraBonus = 0) {
            if (ball.vz <= 0 || ball.z < 245 || ball.z > 505) return false;

            // 當球在球桌兩側大角度時，橫向判定容錯自動拓寬 1.45 倍！
            const sideExpand = Math.abs(ball.x) > T_W * 0.42 ? 1.45 : 1.1;
            const dx3D = Math.abs(ball.x - pPaddle.x) / sideExpand;
            const dy3D = Math.abs(ball.y - pPaddle.y) * 0.8;
            const dist3D = Math.hypot(dx3D, dy3D);
            const limit3D = (chronoTimer > 0 ? 112 : 86) + extraBonus;

            // 2D 螢幕視覺距離檢查 (防止 3D 透視角度造成視覺重疊卻打不中)
            const pb = project(ball.x, ball.y, ball.z);
            const pp = project(pPaddle.x, pPaddle.y, pPaddle.z);
            const distScreen = Math.hypot((pb.x - pp.x) / sideExpand, pb.y - pp.y);
            const paddleScreenR = pPaddle.rx * pp.scale * 2.15 + extraBonus;

            return (dist3D <= limit3D || distScreen <= paddleScreenR);
        }

        function castSkill() {
            if (!gameRunning || isPaused) return;
            const incomingEnemySkill = (ball.vz > 0 && ball.state !== null);
            const reqMana = incomingEnemySkill ? 80 : 100;

            if (mana.p < reqMana) {
                showSideToast('left', 'ENERGY LOW', `需 ${reqMana}% 能量 (空白鍵釋放)`, 'text-slate-400');
                return;
            }

            mana.p = incomingEnemySkill ? Math.max(15, mana.p - 80) : 0;
            updateHUD();

            pPaddle.swingTimer = pPaddle.swingMax;
            pPaddle.hasHitThisSwing = false;

            if (isBallHittableByPlayer(35)) {
                executePlayerReturn(true);
                return;
            }

            pPaddle.prechargedSkill = cfgSkill;
            sfx.skillCast();
            showSideToast('left', SKILL_META[cfgSkill].name, '超能已上膛 · 下次揮拍自動轟出！', SKILL_META[cfgSkill].textCls);
        }

        function checkPlayerHitBall(forceSkill = false) {
            if (pPaddle.swingTimer <= 0 || pPaddle.hasHitThisSwing) return;
            if (isBallHittableByPlayer(0)) {
                // 側面磁吸撲救：揮拍命中瞬間，球拍自動微幅吸附對齊球體 X
                pPaddle.x += (ball.x - pPaddle.x) * 0.45;
                executePlayerReturn(forceSkill || Boolean(pPaddle.prechargedSkill));
            }
        }

        function executePlayerReturn(usePlayerSkill = false) {
            pPaddle.hasHitThisSwing = true;
            let activeSkill = usePlayerSkill ? (pPaddle.prechargedSkill || cfgSkill) : null;
            pPaddle.prechargedSkill = null;

            if (activeSkill) {
                skillUseTotal++;
                if (skillUseTotal === 5 && !skillAwakened) {
                    skillAwakened = true;
                    showTopToast(`🌟 SKILL AWAKENED : ${SKILL_META[cfgSkill].name}`, '本局累積施放 5 次 · 技能永久覺醒（威力+50%、融合必出三階）！');
                }
                // 檢查技能共鳴配對
                if (lastPlayerCastSkill) {
                    const pairKey = [lastPlayerCastSkill, activeSkill].sort().join('+');
                    const pairInfo = RESONANCE_PAIRS[pairKey];
                    if (pairInfo) {
                        showTopToast(`🔗 ${pairInfo.name}`, '觸發雙技能配對共鳴獎勵！');
                        if (pairInfo.effect === 'nextPower') resonancePowerBoost = true;
                        if (pairInfo.effect === 'fastFlight') resonanceFastFlight = true;
                        if (pairInfo.effect === 'instantMana') mana.p = Math.min(100, mana.p + 20);
                        if (pairInfo.effect === 'autoClone') prismShield.player = 2.0;
                        if (pairInfo.effect === 'freezeAi') aPaddle.stunTimer = 1.2;
                    }
                }
                lastPlayerCastSkill = activeSkill;
            }

            if (activeSkill === 'mirror') {
                activeSkill = ball.state || aiMemory.lastAiSkill || 'fire';
            }

            const dist = Math.hypot(ball.x - pPaddle.x, (ball.y - pPaddle.y) * 0.8);
            const isSweetSpot = guaranteedPerfect || (dist <= (chronoTimer > 0 ? 64 : 46) && ball.z >= 315 && ball.z <= 465);
            guaranteedPerfect = false;

            // --- 1. 手勢決定三維旋球 ---
            const swipeSpeed = Math.hypot(pPaddle.vx, pPaddle.vy);
            let spinType = 'flat', spinAccX = 0, spinAccY = 0;
            let isLob = pPaddle.wantLob;
            pPaddle.wantLob = false;

            if (isLob) {
                spinType = 'lob';
                spinAccY = pPaddle.vy < -2 ? 0.08 : 0;
            } else if (swipeSpeed < 2.2) {
                spinType = 'dead';
            } else if (Math.abs(pPaddle.vy) > Math.abs(pPaddle.vx) * 1.25) {
                if (pPaddle.vy > 0) {
                    spinType = 'topspin';
                    spinAccY = -0.14 * Math.min(1.4, swipeSpeed / 14);
                } else {
                    spinType = 'backspin';
                    spinAccY = 0.13 * Math.min(1.4, swipeSpeed / 14);
                }
            } else {
                spinType = 'sidespin';
                spinAccX = Math.sign(pPaddle.vx) * Math.min(0.24, swipeSpeed * 0.014);
            }

            // 旋球專精 (連續 3 球同旋) + 旋球連攜 (5 球內 >= 4 種旋球)
            if (spinType === spinChain.type && spinType !== 'flat') spinChain.count++;
            else { spinChain.type = spinType; spinChain.count = 1; }
            if (spinChain.count >= 3) {
                spinAccX *= 1.45; spinAccY *= 1.45;
                showTopToast(`🌀 ${spinType.toUpperCase()} MASTERY!`, '連續 3 球同旋 · 旋轉曲率 ×1.45！');
            }

            recentSpins.push(spinType);
            if (recentSpins.length > 5) recentSpins.shift();
            if (new Set(recentSpins).size >= 4) {
                recentSpins = [];
                mana.p = Math.min(100, mana.p + 25);
                guaranteedPerfect = true;
                showTopToast('🌈 SPIN COMBO MASTER!', '5 球內施展 4 種旋轉 · 能量 +25% 且下球必出 PERFECT！');
            }

            // --- 2. 融合與破防判定 ---
            let nextSkillState = null, nextTier = 0, displayFusionTitle = '';

            if (ball.state !== null) {
                if (activeSkill) {
                    const fRes = getFusedSkill(ball.state, activeSkill, spinType);
                    nextSkillState = fRes.id;
                    displayFusionTitle = fRes.displayName;
                    const fMeta = SKILL_META[nextSkillState] || SKILL_META.inferno_overload;
                    const isCounter = COUNTER_MAP[activeSkill] === (SKILL_META[ball.state]?.arch || ball.state);
                    nextTier = (fRes.isHardTier3 || isCounter || skillAwakened) ? 3 : 2;

                    sfx.fusionClash();
                    hitStopTimer = 0.09;
                    shake = 30;
                    screenFlashColor = fMeta.color;
                    screenFlashAlpha = 0.5;
                    resonanceActive = true;
                    document.getElementById('resonance-badge').classList.remove('hidden');

                    showTopToast(`⚔️ ${displayFusionTitle}`, `${isCounter ? '【屬性克制 +30%】' : ''}雙重超能共鳴爆發！`);
                    shockwaves.push({ x: ball.x, y: ball.y, z: ball.z, r: 10, maxR: 240, color: fMeta.color, alpha: 1.0 });
                    lightPillars.push({ x: ball.x, z: ball.z, color: fMeta.color, r: 45, alpha: 1.0 });
                } else if (!isSweetSpot && dist > 58) {
                    sfx.guardBreak();
                    pPaddle.knockbackZ = 52;
                    pPaddle.stunTimer = 0.65;
                    shake = 15;
                    showSideToast('right', '💥 GUARD CRUSH!', '偏心接大招被震退！', 'text-rose-400');
                } else {
                    mana.p = Math.min(100, mana.p + 35);
                    showSideToast('left', '🛡️ PERFECT PARRY!', '紅心格擋 · 能量 +35%', 'text-cyan-300');
                }
            } else if (activeSkill) {
                nextSkillState = activeSkill;
                nextTier = skillAwakened ? 3 : skillLevel;
                skillChainCount++;
                document.getElementById('chain-badge').innerText = `CHAIN x${skillChainCount}`;

                if (skillChainCount >= 3) {
                    const fRes = getFusedSkill(activeSkill, activeSkill, spinType);
                    nextSkillState = fRes.id;
                    nextTier = 3;
                    sfx.fusionClash();
                    showTopToast(`🔗 CHAIN OVERLOAD : ${fRes.displayName}`, '同系連擊 3 次觸發超載融合！');
                } else {
                    sfx.skillCast();
                    showSideToast('left', SKILL_META[activeSkill].name, '超能力發動！', SKILL_META[activeSkill].textCls);
                }

                if (activeSkill === 'prism') prismShield.player = 2.6;
                else if (activeSkill === 'chrono') chronoTimer = 1.6;
                else if (activeSkill === 'leech') {
                    const st = Math.min(mana.a, 32);
                    mana.a -= st; mana.p = Math.min(100, mana.p + st);
                }
                hitStopTimer = 0.045;
                shake = 18;
            }

            ball.state = nextSkillState;
            ball.tier = nextTier;
            ball.spinType = spinType;
            ball.spinX = spinAccX;
            ball.spinY = spinAccY;
            ball.lastHitBy = 'player';
            rallyCount++;

            const arch = SKILL_META[ball.state]?.arch;
            if (arch === 'laser') {
                spinAccX = 0; spinAccY = 0;
                ball.spinX = 0;
            } else if (arch === 'sonic') {
                spinAccX = (spinAccX >= 0 ? 1 : -1) * 0.32;
                ball.spinX = spinAccX;
            } else if (arch === 'void') {
                ball.voidTimer = 1.6;
            }

            updateRallyAndSpinUI(spinType, spinAccX, displayFusionTitle);

            let aimX = (ball.x - pPaddle.x) * 1.25 + pPaddle.vx * 9.0 + pPaddle.x * 0.38;
            let targetX = Math.max(-T_W * 0.84, Math.min(T_W * 0.84, aimX));
            let targetZ = spinType === 'dead' ? (-115 - Math.random() * 55) : (-220 - Math.random() * 115);
            let flightFrames = isSweetSpot ? 29 : 34;

            if (aiMemory.totalShots >= 3 && Math.abs(targetX - aiMemory.predictedX) > T_W * 0.65) {
                mana.p = Math.min(100, mana.p + 15);
                showTopToast('🧠 MIND GAME!', '逆向變線騙過 AI · 能量 +15%');
            }
            aiMemory.recordPlayerShot(targetX);

            if (ball.tier >= 2) flightFrames = 18;
            else if (ball.state) flightFrames = ball.state === 'frost' ? 26 : 21;

            if (resonanceFastFlight) { flightFrames = Math.round(flightFrames * 0.8); resonanceFastFlight = false; }

            if (ball.state) {
                const m = SKILL_META[ball.state] || SKILL_META.fire;
                spawnParticles(ball.x, ball.y, ball.z, m.color, ball.tier >= 2 ? 50 : 32, 8.5);
                if (m.arch === 'thunder' || m.arch === 'laser') {
                    createLightningChain(ball.x, ball.y, ball.z, targetX, 0, targetZ, m.color);
                }
            } else {
                sfx.hit(isSweetSpot, spinType);
                spawnParticles(ball.x, ball.y, ball.z, isSweetSpot ? '#00f2fe' : '#fff', isSweetSpot ? 22 : 12, 5);
                mana.p = Math.min(100, mana.p + (isSweetSpot ? 28 : 18) * (resonanceActive ? 1.4 : 1.0));
            }

            updateHUD();
            launchBall3DSpin(targetX, targetZ, flightFrames, spinAccX, spinAccY, isLob);
        }

        // ================= AI 行為與對撞 =================
        function updateAI(dt) {
            const prof = AI_PROFILES[cfgDiff];
            const timeScale = chronoTimer > 0 ? 0.58 : 1.0;

            if (aPaddle.stunTimer > 0) aPaddle.stunTimer -= dt;
            if (aPaddle.knockbackZ < 0) aPaddle.knockbackZ = Math.min(0, aPaddle.knockbackZ + dt * 110);

            if (ball.vz < 0) {
                let desiredX = ball.x + ball.vx * 8 + aiMemory.predictedX * 0.25;
                const arch = SKILL_META[ball.state]?.arch;

                if (arch === 'ghost' || arch === 'void' || ball.voidTimer > 0) {
                    const confuse = cfgDiff === 'hard' ? 0.35 : 0.75;
                    desiredX += Math.sin(ball.z * 0.05) * 95 * confuse;
                }

                let fieldSlow = 1.0;
                lingeringFields.forEach(f => {
                    if (f.z < 0 && Math.hypot(aPaddle.x - f.x, aPaddle.z - f.z) < f.r * 1.4) {
                        if (f.type === 'gravity') desiredX = desiredX * 0.35 + f.x * 0.65;
                        if (f.type === 'frost') fieldSlow = 0.45;
                        if (f.type === 'thunder' || f.type === 'fire') fieldSlow = 0.48;
                        if (f.type === 'toxin') {
                            aPaddle.poisonStacks += dt * 1.4;
                            if (aPaddle.poisonStacks >= 3) { aPaddle.poisonStacks = 0; aPaddle.stunTimer = 1.0; }
                        }
                    }
                });

                const dx = desiredX - aPaddle.x;
                const moveStep = prof.speed * (aPaddle.stunTimer > 0 ? 0.38 : 1.0) * fieldSlow * timeScale;
                aPaddle.x += Math.sign(dx) * Math.min(Math.abs(dx), moveStep);
                aPaddle.y += (Math.max(20, ball.y) - aPaddle.y) * 0.25;
                aPaddle.tilt = Math.max(-0.38, Math.min(0.38, -dx * 0.015));

                if (ball.z <= -335 && ball.z >= -485 && ball.lastHitBy === 'player') {
                    const distToAi = Math.hypot(ball.x - aPaddle.x, (ball.y - aPaddle.y) * 0.8);
                    let reach = aPaddle.rx * (cfgDiff === 'hard' ? 2.45 : 1.85);
                    if (aPaddle.stunTimer > 0 || aPaddle.knockbackZ < -15) reach *= 0.42;
                    if (ball.tier === 3 && Math.random() > prof.saveRate * 0.55) reach *= 0.2;
                    else if (ball.tier === 2 && Math.random() > prof.saveRate * 0.72) reach *= 0.28;
                    else if (ball.tier === 1 && Math.random() > prof.saveRate) reach *= 0.38;

                    if (distToAi <= reach) executeAiReturn(prof);
                }
            } else {
                const prePosX = aiMemory.predictedX * 0.65;
                aPaddle.x += (prePosX - aPaddle.x) * 0.08 * timeScale;
                aPaddle.y += (42 - aPaddle.y) * 0.1;
                aPaddle.tilt *= 0.9;
            }
            if (aPaddle.swingTimer > 0) aPaddle.swingTimer -= dt;
        }

        function executeAiReturn(prof) {
            ball.lastHitBy = 'ai';
            aPaddle.swingTimer = 0.25;
            rallyCount++;

            const incomingSkill = ball.state;
            let aiNextSkill = null, aiNextTier = 0, fusionLabel = '';
            mana.a = Math.min(100, mana.a + (resonanceActive ? 30 : 22));

            if (incomingSkill && mana.a >= 80 && Math.random() < prof.clashRate) {
                mana.a = 0;
                const counterSkill = AI_SKILL_POOL[Math.floor(Math.random() * AI_SKILL_POOL.length)];
                aiMemory.lastAiSkill = counterSkill;
                const aiSpin = ['topspin', 'sidespin', 'backspin'][Math.floor(Math.random() * 3)];
                const fRes = getFusedSkill(incomingSkill, counterSkill, aiSpin);
                aiNextSkill = fRes.id;
                fusionLabel = fRes.displayName;
                aiNextTier = fRes.isHardTier3 ? 3 : 2;

                sfx.fusionClash();
                hitStopTimer = 0.08;
                shake = 24;
                const fMeta = SKILL_META[aiNextSkill] || SKILL_META.plasma;
                screenFlashColor = fMeta.color;
                screenFlashAlpha = 0.42;
                resonanceActive = true;
                document.getElementById('resonance-badge').classList.remove('hidden');

                showTopToast(`⚠️ AI FUSION : ${fusionLabel}`, `按空白鍵反制融合，或對準紅心格擋！`);
                shockwaves.push({ x: ball.x, y: ball.y, z: ball.z, r: 10, maxR: 200, color: fMeta.color, alpha: 1.0 });
                lightPillars.push({ x: ball.x, z: ball.z, color: fMeta.color, r: 40, alpha: 1.0 });
            } else if (!incomingSkill && mana.a >= 100 && Math.random() < prof.clashRate) {
                mana.a = 0;
                aiNextSkill = AI_SKILL_POOL[Math.floor(Math.random() * AI_SKILL_POOL.length)];
                aiMemory.lastAiSkill = aiNextSkill;
                aiNextTier = 1;
                sfx.skillCast();
                shake = 15;
                const sMeta = SKILL_META[aiNextSkill];
                if (aiNextSkill === 'leech') mana.p = Math.max(0, mana.p - 25);
                if (aiNextSkill === 'void') ball.voidTimer = 1.6;
                showSideToast('right', `AI ${sMeta.name}`, '按空白鍵可觸發【融合神技】！', 'text-pink-400');
            } else {
                const arch = SKILL_META[incomingSkill]?.arch;
                if (arch === 'fire') aPaddle.knockbackZ = -48;
                if (arch === 'thunder') aPaddle.stunTimer = 0.95;
                sfx.hit(false, 'flat');
                spawnParticles(ball.x, ball.y, ball.z, '#ec4899', 14, 4.5);
            }

            ball.state = aiNextSkill;
            ball.tier = aiNextTier;
            updateHUD();

            const targetSide = pPaddle.x > 0 ? -1 : 1;
            // 適度收斂 AI 打向兩側的極限角度，讓玩家接側面球更舒適
            let targetX = targetSide * (0.28 + Math.random() * 0.44) * T_W * prof.spread;
            let targetZ = 195 + Math.random() * 105;
            let flightFrames = prof.flightFrames;

            let aiSpinX = (Math.random() - 0.5) * (cfgDiff === 'hard' ? 0.18 : 0.09);
            let aiSpinY = (Math.random() - 0.5) * 0.10;
            ball.spinType = Math.abs(aiSpinX) > 0.07 ? 'sidespin' : 'topspin';
            ball.spinX = aiSpinX;
            ball.spinY = aiSpinY;
            updateRallyAndSpinUI(ball.spinType, aiSpinX, fusionLabel);

            if (aiNextTier >= 2) flightFrames = Math.max(22, prof.flightFrames - 9);
            else if (aiNextTier === 1) flightFrames = Math.max(25, prof.flightFrames - 6);

            launchBall3DSpin(targetX, targetZ, flightFrames, aiSpinX, aiSpinY, false);
        }

        // ================= 主循環與桌面彈跳 =================
        let lastTime = performance.now();

        function loop() {
            const now = performance.now();
            const rawDt = Math.min(0.04, (now - lastTime) / 1000);
            lastTime = now;

            if (chronoTimer > 0) chronoTimer = Math.max(0, chronoTimer - rawDt);
            if (prismShield.player > 0) prismShield.player = Math.max(0, prismShield.player - rawDt);
            if (ball.voidTimer > 0) ball.voidTimer = Math.max(0, ball.voidTimer - rawDt);
            if (ball.ringDelayTimer > 0) ball.ringDelayTimer = Math.max(0, ball.ringDelayTimer - rawDt);

            const simSpeed = chronoTimer > 0 ? 0.60 : 1.0;

            if (gameRunning && !isPaused) {
                updatePlayerPaddle(rawDt);

                if (pPaddle.swingTimer > 0) {
                    pPaddle.swingTimer -= rawDt;
                    checkPlayerHitBall(false);
                }

                if (hitStopTimer > 0) {
                    hitStopTimer -= rawDt;
                } else if (roundWaitTimer === 0) {
                    ball.vx += ball.ax * simSpeed;
                    ball.x += ball.vx * simSpeed;
                    ball.y += ball.vy * simSpeed;
                    ball.z += ball.vz * simSpeed;
                    ball.vy += ((ball.lob ? -0.48 : -0.42) + ball.ay) * simSpeed;
                    ball.orbitalAngle += rawDt * 14;

                    lingeringFields.forEach(f => {
                        if (Math.hypot(ball.x - f.x, ball.z - f.z) < f.r) {
                            if (f.type === 'fire') ball.vz *= 1.015;
                            if (f.type === 'frost') ball.vz *= 0.96;
                        }
                    });

                    if (prismShield.player > 0 && ball.vz > 0 && ball.z >= 365 && ball.z <= 425) {
                        prismShield.player = 0;
                        sfx.fusionClash();
                        showSideToast('left', '🛡️ PRISM AUTO-REFLECT!', '力場自動反彈來球！', 'text-cyan-300');
                        executePlayerReturn(true);
                    }

                    ball.trail.push({ x: ball.x, y: ball.y, z: ball.z });
                    const maxTrail = ball.tier >= 2 ? 26 : (ball.state ? 22 : 16);
                    while (ball.trail.length > maxTrail) ball.trail.shift();

                    updateActiveSkillFlight(rawDt);

                    const onTableX = Math.abs(ball.x) <= T_W + 18;
                    const onTableZ = Math.abs(ball.z) <= T_L + 18;

                    if (ball.y <= 0 && ball.vy < 0 && onTableX && onTableZ) {
                        handleTableBounce();
                    }

                    updateAI(rawDt);

                    if (ball.z > 575 || ball.z < -575 || ball.y < FLOOR_Y) {
                        resolvePoint();
                    }
                }
            }

            updateEffects(rawDt);
            if (shake > 0) shake = Math.max(0, shake - rawDt * 45);
            if (screenFlashAlpha > 0) screenFlashAlpha = Math.max(0, screenFlashAlpha - rawDt * 2.2);

            drawScene();
            requestAnimationFrame(loop);
        }

        function updateActiveSkillFlight(dt) {
            if (!ball.state) return;
            const meta = SKILL_META[ball.state] || SKILL_META.fire;
            const arch = meta.arch;

            if (arch === 'fire' || ball.tier >= 2) {
                spawnParticles(ball.x, ball.y, ball.z, Math.random() > 0.4 ? meta.color : meta.glow, ball.tier >= 2 ? 5 : 2, 4);
            }
            if (arch === 'ghost') {
                const w = Math.sin(ball.z * 0.045) * (ball.tier >= 2 ? 68 : 48);
                ball.ghostOffsets[0] = { x: w, y: Math.cos(ball.z * 0.05) * 16 };
                ball.ghostOffsets[1] = { x: -w, y: -Math.cos(ball.z * 0.05) * 16 };
                ball.ghostOffsets[2] = { x: Math.cos(ball.z * 0.04) * 58, y: Math.sin(ball.z * 0.05) * 18 };
            }
            if (arch === 'thunder' && Math.random() < (ball.tier >= 2 ? 0.45 : 0.30)) {
                const oldX = ball.x;
                const shift = (Math.random() - 0.5) * (ball.tier >= 2 ? 50 : 34);
                ball.x = Math.max(-T_W * 0.82, Math.min(T_W * 0.82, ball.x + shift));
                createLightningChain(oldX, ball.y, ball.z, ball.x, ball.y, ball.z - ball.vz * 2, meta.color);
            }
            if (arch === 'sonic' || ball.tier === 3) {
                if (Math.random() < 0.35) {
                    shockwaves.push({ x: ball.x, y: ball.y, z: ball.z, r: 8, maxR: ball.tier >= 2 ? 85 : 54, color: meta.color, alpha: 0.8 });
                }
            }
        }

        function handleTableBounce() {
            ball.y = 0;
            ball.bouncedOnTarget = true;
            ball.showLandingRing = false;

            ball.vx += ball.ax * 8.5;
            ball.ax = 0;
            ball.ay = 0;

            // 當球落在玩家半場側面時，自動收斂向外飛出的橫向速度，防止飛出畫面接不到！
            if (ball.z > 0 && Math.abs(ball.x) > T_W * 0.45 && Math.sign(ball.vx) === Math.sign(ball.x)) {
                ball.vx *= 0.45;
            }

            if (ball.spinType === 'topspin') {
                ball.vz *= 1.25;
                ball.vy = -ball.vy * 0.68;
            } else if (ball.spinType === 'backspin') {
                ball.vz *= (spinChain.count >= 3 || (ball.tier >= 2 && Math.random() < 0.3) ? 0.38 : 0.62);
                ball.vy = -ball.vy * 0.92;
            } else if (ball.spinType === 'lob') {
                ball.vy = -ball.vy * 0.88;
                ball.vz *= 0.82;
                if (ball.tier >= 2) shake = 18;
            } else {
                ball.vy = -ball.vy * 0.82;
            }

            ball.vx = Math.max(-8.2, Math.min(8.2, ball.vx));

            if (ball.state) {
                const meta = SKILL_META[ball.state] || SKILL_META.fire;
                const arch = meta.arch;
                let fieldR = (ball.tier >= 2 ? 78 : 56) * (skillLevel > 1 ? 1.25 : 1.0);

                sfx.bounce(true);
                shockwaves.push({ x: ball.x, y: 1, z: ball.z, r: 10, maxR: fieldR * 1.6, color: meta.color, alpha: 0.95, isFlat: true });
                spawnParticles(ball.x, 3, ball.z, meta.color, ball.tier >= 2 ? 42 : 24, 7.5);

                if (ball.tier >= 2) {
                    lightPillars.push({ x: ball.x, z: ball.z, color: meta.color, r: 38, alpha: 1.0 });
                    shake = ball.tier === 3 ? 24 : 16;
                } else {
                    shake = 9;
                }

                if (arch === 'gravity') {
                    ball.vy *= 0.32;
                    lingeringFields.push({ x: ball.x, z: ball.z, r: fieldR, type: 'gravity', timer: 2.2, color: '#a855f7' });
                } else if (arch === 'fire') {
                    ball.vz *= 1.15;
                    lingeringFields.push({ x: ball.x, z: ball.z, r: fieldR, type: 'fire', timer: 2.2, color: '#f97316' });
                } else if (arch === 'thunder') {
                    if (ball.state === 'sky_thunder') createLightningChain(ball.x, 260, ball.z, ball.x, 0, ball.z, '#fef08a');
                    lingeringFields.push({ x: ball.x, z: ball.z, r: fieldR, type: 'thunder', timer: 2.2, color: '#fef08a' });
                    if (ball.z > 0) pPaddle.stunTimer = 0.65;
                    else aPaddle.stunTimer = 0.85;
                } else if (arch === 'sonic') {
                    ball.vz *= 1.26;
                } else if (arch === 'laser') {
                    ball.vy *= 0.15; // 貼地零彈跳滑行
                    ball.vz *= 1.32;
                    lingeringFields.push({ x: ball.x, z: ball.z, r: 40, type: 'laser', timer: 1.4, color: '#00f2fe' });
                } else if (arch === 'frost') {
                    lingeringFields.push({ x: ball.x, z: ball.z, r: 90, type: 'frost', timer: 2.4, color: '#7dd3fc' });
                } else if (arch === 'toxin') {
                    lingeringFields.push({ x: ball.x, z: ball.z, r: 65, type: 'toxin', timer: 3.0, color: '#a3e635' });
                } else if (arch === 'void') {
                    ball.voidTimer = 1.6;
                }

                if (lingeringFields.length > 4) lingeringFields.shift();
            } else {
                sfx.bounce(false);
                shockwaves.push({ x: ball.x, y: 1, z: ball.z, r: 5, maxR: 36, color: '#00f2fe', alpha: 0.7, isFlat: true });
            }
        }

        function resolvePoint() {
            if (roundWaitTimer > 0) return;
            roundWaitTimer = 1;
            ball.showLandingRing = false;
            resonanceActive = false;
            document.getElementById('resonance-badge').classList.add('hidden');

            if (ball.z > 495 || (ball.z > 0 && ball.y < FLOOR_Y)) {
                skillChainCount = 0;
                document.getElementById('chain-badge').innerText = 'CHAIN x0';
                scorePoint('ai', 'MISSED BALL');
            } else {
                scorePoint('player', 'WINNER SHOT');
            }
        }

        function scorePoint(winner, reason) {
            sfx.score(winner === 'player');
            if (winner === 'player') {
                scores.p++;
                document.getElementById('score-player').innerText = scores.p;
                showTopToast('🏆 POINT WON!', reason);
            } else {
                scores.a++;
                document.getElementById('score-ai').innerText = scores.a;
                showTopToast('⚠️ AI SCORED', reason);
            }

            if (scores.p >= 7 || scores.a >= 7) setTimeout(showGameOver, 1100);
            else setTimeout(serveBall, 1100);
        }

        function serveBall() {
            roundWaitTimer = 0;
            rallyCount = 0;
            ball.state = null;
            ball.tier = 0;
            ball.spinType = 'flat';
            ball.spinX = 0; ball.spinY = 0; ball.ax = 0; ball.ay = 0;
            ball.lob = false;
            ball.voidTimer = 0;
            ball.trail = [];
            updateRallyAndSpinUI('flat', 0);

            ball.x = (Math.random() - 0.5) * 65;
