        function drawTableLegs3D() {
            const legX = T_W * 0.72, nearZ = T_L * 0.82, farZ = -T_L * 0.82;
            const sNL = project(-T_W * 0.95, FLOOR_Y, T_L * 0.95), sNR = project(T_W * 0.95, FLOOR_Y, T_L * 0.95);
            const sFR = project(T_W * 0.95, FLOOR_Y, -T_L * 0.95), sFL = project(-T_W * 0.95, FLOOR_Y, -T_L * 0.95);
            ctx.beginPath(); ctx.moveTo(sNL.x, sNL.y); ctx.lineTo(sNR.x, sNR.y); ctx.lineTo(sFR.x, sFR.y); ctx.lineTo(sFL.x, sFL.y); ctx.closePath();
            ctx.fillStyle = 'rgba(0, 0, 0, 0.55)'; ctx.fill();

            [[-legX, farZ], [legX, farZ]].forEach(([lx, lz]) => {
                const top = project(lx, -15, lz), bot = project(lx, FLOOR_Y, lz);
                ctx.beginPath(); ctx.moveTo(top.x, top.y); ctx.lineTo(bot.x, bot.y);
                ctx.strokeStyle = '#0f172a'; ctx.lineWidth = 10 * top.scale; ctx.stroke();
            });

            const nLT = project(-legX, -18, nearZ), nLB = project(-legX, FLOOR_Y, nearZ);
            const nRT = project(legX, -18, nearZ), nRB = project(legX, FLOOR_Y, nearZ);
            const barL = project(-legX, FLOOR_Y * 0.55, nearZ), barR = project(legX, FLOOR_Y * 0.55, nearZ);
            ctx.beginPath(); ctx.moveTo(barL.x, barL.y); ctx.lineTo(barR.x, barR.y);
            ctx.strokeStyle = '#1e293b'; ctx.lineWidth = 8 * barL.scale; ctx.stroke();

            ctx.strokeStyle = '#0f172a'; ctx.lineWidth = 15 * nLT.scale;
            ctx.beginPath(); ctx.moveTo(nLT.x, nLT.y); ctx.lineTo(nLB.x, nLB.y); ctx.moveTo(nRT.x, nRT.y); ctx.lineTo(nRB.x, nRB.y); ctx.stroke();
        }

        function drawTableSurface3D() {
            const pNL = project(-T_W, 0, T_L), pNR = project(T_W, 0, T_L);
            const pFR = project(T_W, 0, -T_L), pFL = project(-T_W, 0, -T_L);

            ctx.beginPath(); ctx.moveTo(pNL.x, pNL.y); ctx.lineTo(pNR.x, pNR.y); ctx.lineTo(pFR.x, pFR.y); ctx.lineTo(pFL.x, pFL.y); ctx.closePath();
            const tGrad = ctx.createLinearGradient(0, pFL.y, 0, pNL.y);
            tGrad.addColorStop(0, '#0f2756'); tGrad.addColorStop(0.5, '#163b82'); tGrad.addColorStop(1, '#1c499c');
            ctx.fillStyle = tGrad; ctx.fill();

            ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 3.5;
            ctx.shadowColor = resonanceActive ? '#e879f9' : '#00f2fe'; ctx.shadowBlur = 12; ctx.stroke(); ctx.shadowBlur = 0;

            const pCN = project(0, 0, T_L), pCF = project(0, 0, -T_L);
            ctx.beginPath(); ctx.moveTo(pCN.x, pCN.y); ctx.lineTo(pCF.x, pCF.y);
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)'; ctx.lineWidth = 2.5; ctx.stroke();

            const pNLB = project(-T_W, -20, T_L), pNRB = project(T_W, -20, T_L);
            ctx.beginPath(); ctx.moveTo(pNL.x, pNL.y); ctx.lineTo(pNR.x, pNR.y); ctx.lineTo(pNRB.x, pNRB.y); ctx.lineTo(pNLB.x, pNLB.y); ctx.closePath();
            ctx.fillStyle = '#09152e'; ctx.fill(); ctx.strokeStyle = '#00f2fe'; ctx.lineWidth = 1.5; ctx.stroke();

            // 六、繪製 6 大地形殘留場
            lingeringFields.forEach(f => {
                const pf = project(f.x, 1, f.z);
                if (pf.vis) {
                    const rx = f.r * pf.scale, ry = rx * 0.45;
                    ctx.save(); ctx.translate(pf.x, pf.y);
                    ctx.beginPath(); ctx.ellipse(0, 0, rx, ry, 0, 0, Math.PI * 2);
                    ctx.fillStyle = f.color; ctx.globalAlpha = Math.min(0.45, f.timer * 0.22); ctx.fill();
                    ctx.strokeStyle = f.color; ctx.globalAlpha = Math.min(0.9, f.timer * 0.45);
                    ctx.lineWidth = 2.5; ctx.setLineDash([8, 6]); ctx.stroke();
                    ctx.restore();
                }
            });

            // 雙向落點預警光圈 (支援弧光延遲與虛實假落點)
            if (ball.showLandingRing && ball.ringDelayTimer <= 0) {
                const dispX = Math.max(-T_W * 0.9, Math.min(T_W * 0.9, ball.targetX + ball.fakeRingOffsetX));
                const pTarget = project(dispX, 0, ball.targetZ);
                if (pTarget.vis) {
                    const isPlayerShot = ball.vz < 0;
                    const ringColor = isPlayerShot ? '#fbbf24' : '#00f2fe';
                    const pulse = 0.72 + 0.28 * Math.sin(performance.now() * 0.016);
                    const ringR = (isPlayerShot ? 28 : 26) * pTarget.scale * pulse;

                    ctx.save();
                    ctx.beginPath(); ctx.ellipse(pTarget.x, pTarget.y, ringR * 1.45, ringR * 0.68, 0, 0, Math.PI * 2);
                    ctx.strokeStyle = ringColor; ctx.lineWidth = 2.5; ctx.shadowColor = ringColor; ctx.shadowBlur = 12; ctx.stroke();
                    ctx.beginPath(); ctx.arc(pTarget.x, pTarget.y, 4.5 * pTarget.scale, 0, Math.PI * 2);
                    ctx.fillStyle = '#fff'; ctx.fill();
                    ctx.restore();
                }
            }
        }

        function drawPrismShieldWall() {
            if (prismShield.player <= 0) return;
            const zPos = 385;
            const pL = project(-T_W * 0.95, 0, zPos), pR = project(T_W * 0.95, 0, zPos);
            const pTR = project(T_W * 0.95, 68, zPos), pTL = project(-T_W * 0.95, 68, zPos);
            if (pL.vis && pR.vis) {
                ctx.save();
                ctx.beginPath(); ctx.moveTo(pL.x, pL.y); ctx.lineTo(pR.x, pR.y); ctx.lineTo(pTR.x, pTR.y); ctx.lineTo(pTL.x, pTL.y); ctx.closePath();
                ctx.fillStyle = 'rgba(34, 211, 238, 0.22)'; ctx.fill();
                ctx.strokeStyle = '#22d3ee'; ctx.lineWidth = 2.5; ctx.shadowColor = '#22d3ee'; ctx.shadowBlur = 15; ctx.stroke();
                ctx.restore();
            }
        }

        function drawNet3D() {
            const netW = T_W + 18;
            const nLB = project(-netW, 0, 0), nRB = project(netW, 0, 0);
            const nLT = project(-netW, NET_H, 0), nRT = project(netW, NET_H, 0);

            ctx.beginPath(); ctx.moveTo(nLB.x, nLB.y); ctx.lineTo(nRB.x, nRB.y); ctx.lineTo(nRT.x, nRT.y); ctx.lineTo(nLT.x, nLT.y); ctx.closePath();
            ctx.fillStyle = 'rgba(15, 23, 42, 0.52)'; ctx.fill();

            ctx.strokeStyle = 'rgba(255, 255, 255, 0.22)'; ctx.lineWidth = 1;
            for (let x = -T_W; x <= T_W; x += 22) {
