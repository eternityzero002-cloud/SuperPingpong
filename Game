        class AudioEngine {
            constructor() { this.ctx = null; this.muted = false; }
            init() {
                if (!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                if (this.ctx.state === 'suspended') this.ctx.resume();
            }
            playTone(type, f1, f2, dur, vol = 0.32, delay = 0) {
                if (!this.ctx || this.muted) return;
                const now = this.ctx.currentTime + delay;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(f1, now);
                if (f2) osc.frequency.exponentialRampToValueAtTime(Math.max(20, f2), now + dur);
                gain.gain.setValueAtTime(vol, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + dur);
                osc.connect(gain); gain.connect(this.ctx.destination);
                osc.start(now); osc.stop(now + dur);
            }
            swing() { this.playTone('sine', 290, 140, 0.075, 0.16); }
            bounce(isHeavy = false) {
                if (isHeavy) this.playTone('triangle', 220, 60, 0.13, 0.42);
                else this.playTone('sine', 660, 240, 0.06, 0.26);
            }
            hit(isPerfect = false, spinType = 'flat') {
