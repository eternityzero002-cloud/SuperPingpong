            for (let x = -1200; x <= 1200; x += 120) {
                const pN = project(x, FLOOR_Y, 640), pF = project(x, FLOOR_Y, -750);
                if (pN.vis && pF.vis) { ctx.beginPath(); ctx.moveTo(pN.x, pN.y); ctx.lineTo(pF.x, pF.y); ctx.stroke(); }
            }
            for (let z = -700; z <= 600; z += 110) {
                const pL = project(-1200, FLOOR_Y, z), pR = project(1200, FLOOR_Y, z);
                if (pL.vis && pR.vis) { ctx.beginPath(); ctx.moveTo(pL.x, pL.y); ctx.lineTo(pR.x, pR.y); ctx.stroke(); }
            }
        }

        function drawArenaBarriers() {
            const bH = 65, backZ = -600;
            const panels = [
                { x1: -490, z1: backZ, x2: -175, z2: backZ },
                { x1: -155, z1: backZ, x2: 155, z2: backZ },
                { x1: 175, z1: backZ, x2: 490, z2: backZ },
                { x1: -660, z1: -120, x2: -510, z2: backZ + 20 },
                { x1: 510, z1: backZ + 20, x2: 660, z2: -120 }
            ];
            panels.forEach(pan => {
                const bL = project(pan.x1, FLOOR_Y, pan.z1), bR = project(pan.x2, FLOOR_Y, pan.z2);
                const tR = project(pan.x2, FLOOR_Y + bH, pan.z2), tL = project(pan.x1, FLOOR_Y + bH, pan.z1);
                if (bL.vis && bR.vis && tR.vis && tL.vis) {
                    ctx.beginPath(); ctx.moveTo(bL.x, bL.y); ctx.lineTo(bR.x, bR.y); ctx.lineTo(tR.x, tR.y); ctx.lineTo(tL.x, tL.y); ctx.closePath();
                    ctx.fillStyle = 'rgba(12, 26, 62, 0.85)'; ctx.fill();
                    ctx.strokeStyle = resonanceActive ? '#e879f9' : 'rgba(0, 242, 254, 0.4)'; ctx.lineWidth = 2; ctx.stroke();
                }
            });
