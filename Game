            }

            ctx.beginPath(); ctx.moveTo(nLT.x, nLT.y); ctx.lineTo(nRT.x, nRT.y);
            ctx.strokeStyle = '#fff'; ctx.lineWidth = 3; ctx.shadowColor = '#00f2fe'; ctx.shadowBlur = 8; ctx.stroke(); ctx.shadowBlur = 0;

