            ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2);
            ctx.fillStyle = aPaddle.stunTimer > 0 ? '#fde047' : '#e11d48';
            ctx.strokeStyle = '#fda4af'; ctx.lineWidth = 2.5 * pa.scale; ctx.shadowColor = '#f43f5e'; ctx.shadowBlur = 14;
            ctx.fill(); ctx.stroke();
            ctx.restore();
        }

        function drawBallShadow3D() {
            const onTable = Math.abs(ball.x) <= T_W && Math.abs(ball.z) <= T_L;
            const shadowY = onTable ? 0 : FLOOR_Y;
            const pSh = project(ball.x, shadowY, ball.z);
            if (!pSh.vis) return;
            const h = Math.max(0, ball.y - shadowY);
            const sr = Math.max(2.5, ball.r * 1.35 * pSh.scale * (1 / (1 + h * 0.006)));
            ctx.beginPath(); ctx.ellipse(pSh.x, pSh.y, sr * 1.6, sr * 0.75, 0, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(0, 0, 0, ${Math.max(0.14, 0.7 - h / 260)})`; ctx.fill();
        }

        function drawRibbonBall3D() {
            const pb = project(ball.x, ball.y, ball.z);
            if (!pb.vis) return;

            const sMeta = ball.state ? SKILL_META[ball.state] : null;
            // 🌑 虛空相位週期性閃爍消失效果
            if ((sMeta && sMeta.arch === 'void') || ball.voidTimer > 0) {
                if (Math.sin(performance.now() * 0.038) > 0.35) return;
            }

            const br = Math.max(4, ball.r * pb.scale);
            const spinColors = { topspin: '#fb923c', backspin: '#38bdf8', sidespin: '#34d399', lob: '#a855f7', dead: '#e2e8f0', flat: '#00f2fe' };
            const trailColor = sMeta ? sMeta.color : (spinColors[ball.spinType] || '#00f2fe');

            if (ball.trail.length > 1) {
                ctx.save(); ctx.lineCap = 'round'; ctx.lineJoin = 'round';
                const wMult = ball.tier === 3 ? 3.5 : (ball.tier === 2 ? 2.8 : (ball.state ? 2.2 : 1.5));
                for (let i = 1; i < ball.trail.length; i++) {
                    const p0 = project(ball.trail[i - 1].x, ball.trail[i - 1].y, ball.trail[i - 1].z);
                    const p1 = project(ball.trail[i].x, ball.trail[i].y, ball.trail[i].z);
                    if (p0.vis && p1.vis) {
                        const ratio = i / ball.trail.length;
                        ctx.beginPath(); ctx.moveTo(p0.x, p0.y); ctx.lineTo(p1.x, p1.y);
                        ctx.strokeStyle = trailColor; ctx.lineWidth = br * wMult * ratio;
                        ctx.globalAlpha = ratio * (ball.state ? 0.85 : 0.55);
                        ctx.shadowColor = trailColor; ctx.shadowBlur = ball.tier >= 2 ? 24 : 12; ctx.stroke();

                        if (ball.tier >= 2) {
                            ctx.beginPath(); ctx.moveTo(p0.x, p0.y); ctx.lineTo(p1.x, p1.y);
                            ctx.strokeStyle = '#fff'; ctx.lineWidth = br * 0.9 * ratio; ctx.globalAlpha = ratio * 0.9; ctx.stroke();
                        }
                    }
                }
                ctx.restore();
            }

            if (sMeta && sMeta.arch === 'ghost') {
                const cnt = ball.tier >= 2 ? 3 : 2;
                for (let idx = 0; idx < cnt; idx++) {
                    const off = ball.ghostOffsets[idx];
                    const pg = project(ball.x + off.x, ball.y + off.y, ball.z);
                    if (pg.vis) {
                        ctx.beginPath(); ctx.arc(pg.x, pg.y, br * 0.95, 0, Math.PI * 2);
                        ctx.fillStyle = idx % 2 === 0 ? 'rgba(232, 121, 249, 0.8)' : 'rgba(56, 189, 248, 0.8)';
                        ctx.shadowColor = sMeta.color; ctx.shadowBlur = 16; ctx.fill(); ctx.shadowBlur = 0;
                    }
                }
            }

            if (ball.tier >= 2 && sMeta) {
                ctx.save(); ctx.translate(pb.x, pb.y); ctx.rotate(ball.orbitalAngle);
                ctx.beginPath(); ctx.ellipse(0, 0, br * 2.6, br * 0.85, 0, 0, Math.PI * 2);
                ctx.strokeStyle = sMeta.glow; ctx.lineWidth = 2.5; ctx.shadowColor = sMeta.color; ctx.shadowBlur = 16; ctx.stroke();
                if (ball.tier === 3) {
                    ctx.rotate(Math.PI * 0.5);
                    ctx.beginPath(); ctx.ellipse(0, 0, br * 2.6, br * 0.85, 0, 0, Math.PI * 2);
                    ctx.strokeStyle = sMeta.color; ctx.stroke();
                }
                ctx.restore();
            }

            ctx.save();
            ctx.beginPath(); ctx.arc(pb.x, pb.y, br * (ball.tier >= 2 ? 1.3 : 1.0), 0, Math.PI * 2);
            const bGrad = ctx.createRadialGradient(pb.x - br * 0.3, pb.y - br * 0.3, br * 0.1, pb.x, pb.y, br * 1.3);
            if (sMeta) {
                bGrad.addColorStop(0, '#fff'); bGrad.addColorStop(0.5, sMeta.glow); bGrad.addColorStop(1, sMeta.color);
                ctx.shadowColor = sMeta.color;
            } else {
                bGrad.addColorStop(0, '#fff'); bGrad.addColorStop(0.7, '#fde047'); bGrad.addColorStop(1, '#f59e0b');
                ctx.shadowColor = '#fde047';
            }
            ctx.shadowBlur = ball.tier >= 2 ? 30 : 16;
            ctx.fillStyle = bGrad; ctx.fill();
            ctx.restore();
        }

        function drawPlayerPaddle3D() {
            const swingRatio = pPaddle.swingTimer / pPaddle.swingMax;
            const lungeZ = pPaddle.swingTimer > 0 ? Math.sin(swingRatio * Math.PI) * 42 : 0;
            const pp = project(pPaddle.x, pPaddle.y, pPaddle.z - lungeZ + pPaddle.knockbackZ);
            if (!pp.vis) return;

            const r = pPaddle.rx * pp.scale;
            ctx.save(); ctx.translate(pp.x, pp.y);

            if (pPaddle.inStrikeZone) {
                ctx.beginPath(); ctx.arc(0, 0, r * 1.36, 0, Math.PI * 2);
                ctx.strokeStyle = '#4ade80'; ctx.lineWidth = 2.8; ctx.setLineDash([10, 6]);
                ctx.shadowColor = '#4ade80'; ctx.shadowBlur = 14; ctx.stroke(); ctx.setLineDash([]);
            }

            const swingAngle = pPaddle.swingTimer > 0 ? -Math.sin(swingRatio * Math.PI) * 0.48 : 0;
            ctx.rotate(pPaddle.tilt + swingAngle);

            ctx.fillStyle = '#92400e'; ctx.strokeStyle = '#00f2fe'; ctx.lineWidth = 1.5;
            ctx.beginPath(); ctx.roundRect(-r * 0.17, r * 0.72, r * 0.34, r * 0.72, 4); ctx.fill(); ctx.stroke();

            const rimColor = pPaddle.prechargedSkill
                ? SKILL_META[pPaddle.prechargedSkill].color
                : (pPaddle.inStrikeZone ? '#4ade80' : (mana.p >= 100 ? '#fde047' : '#00f2fe'));

            ctx.beginPath(); ctx.ellipse(0, 0, r, r * 0.94, 0, 0, Math.PI * 2);
            ctx.fillStyle = pPaddle.stunTimer > 0 ? 'rgba(163, 230, 53, 0.5)' : 'rgba(15, 23, 42, 0.85)';
            ctx.strokeStyle = rimColor; ctx.lineWidth = 3.5 * pp.scale; ctx.shadowColor = rimColor;
            ctx.shadowBlur = pPaddle.swingTimer > 0 ? 25 : 12; ctx.fill(); ctx.stroke();

            ctx.beginPath(); ctx.ellipse(0, 0, r * 0.82, r * 0.76, 0, 0, Math.PI * 2);
            ctx.fillStyle = pPaddle.swingTimer > 0 ? 'rgba(0, 242, 254, 0.35)' : 'rgba(30, 41, 59, 0.65)'; ctx.fill();
            ctx.restore();
        }

        function drawAllEffects() {
            lightPillars.forEach(lp => {
                const pb = project(lp.x, 0, lp.z), pt = project(lp.x, 320, lp.z);
                if (pb.vis && pt.vis) {
                    ctx.save();
                    const w = lp.r * pb.scale * lp.alpha;
                    const grad = ctx.createLinearGradient(pb.x, pb.y, pt.x, pt.y);
                    grad.addColorStop(0, lp.color); grad.addColorStop(1, 'rgba(255,255,255,0)');
                    ctx.fillStyle = grad; ctx.globalAlpha = lp.alpha * 0.75;
                    ctx.fillRect(pb.x - w * 0.5, pt.y, w, pb.y - pt.y);
                    ctx.restore();
                }
            });

            shockwaves.forEach(sw => {
                const pj = project(sw.x, sw.y, sw.z);
                if (pj.vis) {
                    ctx.save(); ctx.beginPath();
                    const rx = sw.r * pj.scale, ry = sw.isFlat ? rx * 0.45 : rx;
                    ctx.ellipse(pj.x, pj.y, rx, ry, 0, 0, Math.PI * 2);
                    ctx.strokeStyle = sw.color; ctx.globalAlpha = Math.max(0, sw.alpha);
                    ctx.lineWidth = 3; ctx.shadowColor = sw.color; ctx.shadowBlur = 14; ctx.stroke();
                    ctx.restore();
                }
            });

            ball.lightningBolts.forEach(bolt => {
                ctx.save(); ctx.beginPath();
                bolt.pts.forEach((pt, idx) => {
                    const pj = project(pt.x, pt.y, pt.z);
                    if (idx === 0) ctx.moveTo(pj.x, pj.y); else ctx.lineTo(pj.x, pj.y);
                });
                ctx.strokeStyle = bolt.color || '#fef08a'; ctx.lineWidth = 3.5;
                ctx.globalAlpha = Math.max(0, bolt.alpha); ctx.shadowColor = bolt.color; ctx.shadowBlur = 16; ctx.stroke();
                ctx.restore();
            });

            particles.forEach(p => {
                const pj = project(p.x, p.y, p.z);
                if (pj.vis) {
                    ctx.save(); ctx.beginPath();
                    ctx.arc(pj.x, pj.y, Math.max(1.5, p.s * pj.scale), 0, Math.PI * 2);
                    ctx.fillStyle = p.c; ctx.globalAlpha = Math.max(0, p.a);
                    ctx.shadowColor = p.c; ctx.shadowBlur = 8; ctx.fill();
                    ctx.restore();
                }
            });
        }

        // ================= UI 輔助與流程控制 =================
        let leftToastTimer = null, rightToastTimer = null, topToastTimer = null;

        function showSideToast(side, title, sub, colorClass = 'text-cyan-300') {
            const isLeft = side === 'left';
            const box = document.getElementById(isLeft ? 'left-toast' : 'right-toast');
            const tEl = document.getElementById(isLeft ? 'left-toast-title' : 'right-toast-title');
            const sEl = document.getElementById(isLeft ? 'left-toast-sub' : 'right-toast-sub');
            tEl.className = `text-base sm:text-xl font-black cyber-font ${colorClass}`;
            tEl.innerText = title; sEl.innerText = sub;
            box.classList.remove('opacity-0', isLeft ? '-translate-x-8' : 'translate-x-8');
            if (isLeft) {
                clearTimeout(leftToastTimer);
                leftToastTimer = setTimeout(() => box.classList.add('opacity-0', '-translate-x-8'), 1100);
            } else {
                clearTimeout(rightToastTimer);
                rightToastTimer = setTimeout(() => box.classList.add('opacity-0', 'translate-x-8'), 1100);
            }
        }

        function showTopToast(title, sub) {
            const box = document.getElementById('top-toast');
            document.getElementById('top-toast-title').innerText = title;
            document.getElementById('top-toast-sub').innerText = sub;
            box.classList.remove('opacity-0', 'scale-90');
            clearTimeout(topToastTimer);
            topToastTimer = setTimeout(() => box.classList.add('opacity-0', 'scale-90'), 1350);
        }

        function updateHUD() {
            const pBar = document.getElementById('hud-mana-bar');
            const mBtn = document.getElementById('btn-mobile-skill');
            const mLbl = document.getElementById('btn-skill-label');
            const evBtn = document.getElementById('btn-evolve');

            pBar.style.width = `${mana.p}%`;
            document.getElementById('hud-mana').innerText = `${Math.round(mana.p)}%`;
            if (skillLevel < 2) evBtn.classList.toggle('hidden', mana.p < 100);

            if (mana.p >= 80) {
                pBar.parentElement.classList.add('mana-ready');
                mLbl.innerText = mana.p >= 100 ? "🔥 必殺就緒" : "⚡ 可反制融合";
                mBtn.className = "pointer-events-auto w-24 h-16 sm:w-32 sm:h-14 rounded-2xl bg-gradient-to-r from-amber-500 to-pink-500 active:scale-90 flex flex-col items-center justify-center border border-white shadow-[0_0_20px_rgba(245,158,11,0.8)] animate-pulse";
            } else {
                pBar.parentElement.classList.remove('mana-ready');
                mLbl.innerText = `⚡ ${Math.round(mana.p)}%`;
                mBtn.className = "pointer-events-auto w-20 h-16 sm:w-28 sm:h-14 rounded-2xl cyber-panel active:scale-90 flex flex-col items-center justify-center border border-cyan-400/50 shadow-lg";
            }
        }

        function updateRallyAndSpinUI(spinType, spinX, fusionName = '') {
            const spEl = document.getElementById('spin-indicator');
            if (fusionName) {
                spEl.innerText = fusionName;
                spEl.className = 'text-[10px] font-black text-amber-300';
                return;
            }
            const map = {
                topspin:  { t: '🔥 弧圈上旋 TOPSPIN', c: 'text-amber-300' },
                backspin: { t: '❄️ 削球下旋 BACKSPIN', c: 'text-sky-300' },
                sidespin: { t: `🌪️ 側旋 SIDESPIN ${spinX >= 0 ? '↷' : '↶'}`, c: 'text-emerald-300' },
                lob:      { t: '🎈 高空球 HIGH LOB', c: 'text-purple-300' },
                dead:     { t: '👻 擺短不轉 DEAD', c: 'text-slate-300' },
                flat:     { t: '⚡ 快攻平擊 DRIVE', c: 'text-cyan-200' }
            };
            const info = map[spinType] || map.flat;
            spEl.innerText = `${info.t} · RALLY ${rallyCount}`;
            spEl.className = `text-[10px] font-bold ${info.c}`;
        }

        function initMatch() {
            sfx.init();
            // 點擊開始遊戲時自動進入全螢幕
            if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(() => {});
            }

            document.getElementById('setup-modal').classList.add('hidden');
            document.getElementById('gameover-modal').classList.add('hidden');
            document.getElementById('pause-modal').classList.add('hidden');
            document.getElementById('in-game-hud').classList.remove('hidden');
            document.getElementById('bottom-bar').classList.remove('hidden');

            const sMeta = SKILL_META[cfgSkill];
            const sEl = document.getElementById('hud-skill-name');
            sEl.innerText = sMeta.name;
            sEl.className = `font-black text-xs ${sMeta.textCls} truncate max-w-[115px] sm:max-w-[140px]`;
            document.getElementById('hud-diff-tag').innerText = AI_PROFILES[cfgDiff].name;

            restartMatch();
        }

        function restartMatch() {
            sfx.init();
            isPaused = false;
            document.getElementById('pause-modal').classList.add('hidden');
            document.getElementById('gameover-modal').classList.add('hidden');
            scores = { p: 0, a: 0 };
            mana = { p: 100, a: 40 };
            skillLevel = 1; skillChainCount = 0; skillUseTotal = 0; skillAwakened = false;
            spinChain = { type: 'flat', count: 0 };
            recentSpins = []; guaranteedPerfect = false; lastPlayerCastSkill = null;
            resonanceActive = false; chronoTimer = 0; prismShield = { player: 0, ai: 0 };
            lingeringFields = []; pPaddle.poisonStacks = 0; aPaddle.poisonStacks = 0;

            document.getElementById('hud-skill-lv').innerText = 'LV.1';
            document.getElementById('chain-badge').innerText = 'CHAIN x0';
            document.getElementById('resonance-badge').classList.add('hidden');

            aiMemory.reset();
            document.getElementById('score-player').innerText = '0';
            document.getElementById('score-ai').innerText = '0';
            updateHUD();
            gameRunning = true;
            serveBall();
            showTopToast('MATCH START', '左鍵揮拍旋球 · 右鍵高空球 · 空白鍵釋放超能力！');
        }

        function togglePause() {
            if (!gameRunning) return;
            isPaused = !isPaused;
            document.getElementById('pause-modal').classList.toggle('hidden', !isPaused);
        }

        function exitToMenu() {
            gameRunning = false; isPaused = false;
            document.getElementById('pause-modal').classList.add('hidden');
            document.getElementById('gameover-modal').classList.add('hidden');
            document.getElementById('in-game-hud').classList.add('hidden');
            document.getElementById('bottom-bar').classList.add('hidden');
            document.getElementById('setup-modal').classList.remove('hidden');
        }

        function showGameOver() {
            gameRunning = false;
            document.getElementById('gameover-modal').classList.remove('hidden');
            const won = scores.p > scores.a;
            const title = document.getElementById('go-title');
            title.innerText = won ? "VICTORY!" : "DEFEATED";
            title.className = `text-4xl font-black cyber-font mb-1 ${won ? 'text-cyan-400' : 'text-pink-500'}`;
            document.getElementById('go-sub').innerText = won ? "你以三維旋球與 91 種超能融合徹底征服了賽場！" : "AI 神經網路識破了你的球路，再接再厲！";
            document.getElementById('go-p1').innerText = scores.p;
            document.getElementById('go-ai').innerText = scores.a;
        }

        requestAnimationFrame(loop);
    </script>
