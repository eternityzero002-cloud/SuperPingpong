        function launchBall3DSpin(targetX, targetZ, flightFrames, spinAccX = 0, spinAccY = 0, isLob = false) {
            const frames = Math.max(15, isLob ? 56 : flightFrames);
            ball.ax = spinAccX;
            ball.ay = spinAccY;
            ball.lob = isLob;

            const effG = (isLob ? -0.48 : -0.42) + ball.ay;
            ball.vx = (targetX - ball.x - 0.5 * ball.ax * frames * frames) / frames;
            ball.vz = (targetZ - ball.z) / frames;
            ball.vy = (0 - ball.y - 0.5 * effG * frames * frames) / frames;

            const framesToNet = Math.abs((0 - ball.z) / (ball.vz || 1));
            if (framesToNet > 0 && framesToNet < frames) {
                const yAtNet = ball.y + ball.vy * framesToNet + 0.5 * effG * framesToNet * framesToNet;
                const minClear = isLob ? NET_H + 85 : NET_H + 15;
                if (yAtNet < minClear) ball.vy += (minClear - yAtNet) / framesToNet;
            }

            ball.targetX = targetX;
            ball.targetZ = targetZ;
            ball.bouncedOnTarget = false;
            ball.showLandingRing = true;
            ball.ringDelayTimer = (ball.state && ball.spinType === 'sidespin') ? 0.3 : 0;
            ball.fakeRingOffsetX = (ball.state && ball.spinType === 'dead') ? ((Math.random() > 0.5 ? 1 : -1) * 75) : 0;
        }

